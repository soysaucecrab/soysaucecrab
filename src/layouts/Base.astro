---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { type Lang, type Page, pathFor } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: Page;
  title?: string;
  description?: string;
}
const { lang, page, title, description } = Astro.props;

const navPages: Page[] = ['news', 'publications', 'projects'];
const docTitle = title ?? (page === 'home' ? 'zinu.kim' : `zinu.kim — ${page}`);
const desc =
  description ??
  (lang === 'ko'
    ? 'Zinu Kim — ML 엔지니어이자 개발자. 성균관대학교 지능형소프트웨어학과.'
    : 'Zinu Kim — ML engineer and developer. Intelligent Software, Sungkyunkwan University.');
---
<!doctype html>
<html lang={lang === 'ko' ? 'ko' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={new URL(pathFor('en', page), Astro.site)} />
    <link rel="alternate" hreflang="ko" href={new URL(pathFor('ko', page), Astro.site)} />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="topbar">
      <div class="in">
        <a class="brand" href={pathFor(lang, 'home')}><b>zinu.kim</b></a>
        <span class="right">
          <nav class="nav" aria-label="Sections">
            {navPages.map((p) => (
              <a href={pathFor(lang, p)} data-route={p} aria-current={page === p ? 'page' : undefined}>{p}</a>
            ))}
          </nav>
          <span class="lang">
            <a href={pathFor('en', page)} aria-current={lang === 'en' ? 'true' : undefined} hreflang="en">EN</a>
            <a href={pathFor('ko', page)} aria-current={lang === 'ko' ? 'true' : undefined} hreflang="ko">KO</a>
          </span>
        </span>
      </div>
    </div>
    <main class="wrap" id="main">
      <slot />
      <footer><span>© 2026 Zinu Kim 🦀</span><span>Seoul, KR</span></footer>
    </main>
  </body>
</html>
