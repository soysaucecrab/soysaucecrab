---
import '../styles/fonts.css';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>zinu.kim</title>
<meta name="description" content="Zinu Kim — ML engineer and developer. Intelligent Software, Sungkyunkwan University." />
<meta property="og:title" content="zinu.kim — Zinu Kim" />
<meta property="og:description" content="ML Engineer & Developer. Intelligent Software, Sungkyunkwan University." />
<meta property="og:type" content="website" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<script is:inline>if(window.matchMedia&&matchMedia('(max-width:720px)').matches){location.replace('/m'+location.hash);}</script>
<style is:global>
  :root{
    --bg:#F4EEE1; --side:#EAE1CE; --fg:#1A1613; --dim:#7C7362; --line:#D8CDB6;
    --panel:#E4DAC5; --crab:#D33A1C; --crabink:#A82F13; --sel:#E0D4B8; --hover:#0000000a;
    --ui:'Ubuntu','Noto Sans KR','Apple SD Gothic Neo',system-ui,-apple-system,sans-serif;
    --mono:'Ubuntu Mono','Noto Sans KR',ui-monospace,Menlo,Consolas,monospace;
  }
  @media (prefers-color-scheme:dark){
    :root{ --bg:#17120C; --side:#100C07; --fg:#EDE7D8; --dim:#948B7B; --line:#2E271D; --panel:#1E1811; --crab:#F26A45; --crabink:#F26A45; --sel:#241C12; --hover:#ffffff0d; }
  }
  :root[data-theme="light"]{ --bg:#F4EEE1; --side:#EAE1CE; --fg:#1A1613; --dim:#7C7362; --line:#D8CDB6; --panel:#E4DAC5; --crab:#D33A1C; --crabink:#A82F13; --sel:#E0D4B8; --hover:#0000000a; }
  :root[data-theme="dark"]{ --bg:#17120C; --side:#100C07; --fg:#EDE7D8; --dim:#948B7B; --line:#2E271D; --panel:#1E1811; --crab:#F26A45; --crabink:#F26A45; --sel:#241C12; --hover:#ffffff0d; }

  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--ui);font-size:14px;-webkit-font-smoothing:antialiased;overflow:hidden;}
  a{color:inherit;text-decoration:none;}
  .m{font-family:var(--mono);}

  .app{display:grid;grid-template-rows:38px 1fr 24px;height:100vh;}

  /* top bar */
  .topbar{display:flex;align-items:center;gap:12px;padding:0 12px;background:var(--side);border-bottom:1px solid var(--line);font-family:var(--mono);font-size:12px;color:var(--dim);}
  .topbar .burger{display:none;cursor:pointer;padding:4px;border-radius:6px;color:var(--fg);}
  .topbar .brandname{color:var(--fg);font-weight:600;}
  .topbar .grow{flex:1;}
  .kbd{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:6px;padding:3px 8px;color:var(--dim);cursor:pointer;background:var(--bg);}
  .kbd:hover{border-color:var(--crab);color:var(--crabink);}
  .lang{display:inline-flex;border:1px solid var(--line);border-radius:6px;overflow:hidden;}
  .lang button{font-family:var(--mono);font-size:11px;padding:3px 8px;background:transparent;color:var(--dim);border:0;cursor:pointer;}
  .lang button.on{background:var(--crab);color:var(--bg);}
  .icobtn{cursor:pointer;color:var(--dim);padding:3px;border-radius:6px;display:flex;}
  .icobtn:hover{color:var(--crabink);}
  .icobtn svg{width:16px;height:16px;}

  .mid{display:grid;grid-template-columns:252px 1fr;min-height:0;}

  /* explorer */
  .explorer{background:var(--side);border-right:1px solid var(--line);overflow:auto;min-height:0;}
  .explorer .eh{padding:12px 16px 6px;font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);display:flex;justify-content:space-between;}
  .tree{padding-bottom:16px;font-family:var(--mono);font-size:13px;}
  .trow{display:flex;align-items:center;gap:7px;height:25px;padding:0 10px;cursor:pointer;color:var(--fg);white-space:nowrap;}
  .trow:hover{background:var(--hover);}
  .trow.sel{background:var(--sel);}
  .trow .tw{width:12px;color:var(--dim);font-size:10px;flex-shrink:0;text-align:center;}
  .trow .ic{width:15px;flex-shrink:0;color:var(--dim);display:flex;justify-content:center;}
  .trow .ic.md{color:var(--crabink);font-weight:700;font-size:10px;}
  .trow .ic.ext{color:var(--dim);}
  .trow.dim{color:var(--dim);}
  .trow .ext-mark{margin-left:auto;color:var(--dim);font-size:11px;padding-left:8px;}
  .kids.hide{display:none;}

  /* editor column */
  .edcol{display:grid;grid-template-rows:34px 30px 1fr 30px;min-height:0;min-width:0;background:var(--bg);}
  .edcol.term-open{grid-template-rows:34px 30px 1fr 210px;}
  .terminal{border-top:1px solid var(--line);background:var(--bg);display:flex;flex-direction:column;min-height:0;overflow:hidden;}
  .terminal .th{height:29px;display:flex;align-items:center;gap:16px;padding:0 14px;border-bottom:1px solid var(--line);font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--dim);cursor:pointer;flex-shrink:0;}
  .terminal .th .on{color:var(--fg);}
  .terminal .th .grow{flex:1;}
  .terminal .th .chev{transition:transform .15s;font-size:13px;}
  .edcol.term-open .terminal .th .chev{transform:rotate(180deg);}
  .terminal .body{flex:1;overflow:auto;padding:8px 14px 10px;font-family:var(--mono);font-size:12.5px;line-height:1.55;cursor:text;}
  .edcol:not(.term-open) .terminal .body{display:none;}
  .terminal .ln{white-space:pre-wrap;word-break:break-word;}
  .terminal .ln.err{color:var(--crab);}
  .terminal .u{color:#2f7d5e;} .terminal .p{color:var(--crabink);} .terminal .c{color:var(--dim);}
  @media (prefers-color-scheme:dark){.terminal .u{color:#6fca9f;}}
  .terminal .inrow{display:flex;align-items:baseline;}
  .terminal .inrow input{border:0;background:transparent;color:var(--fg);font-family:var(--mono);font-size:12.5px;outline:none;padding:0;caret-color:transparent;width:0;min-width:0;}
  @keyframes termblink{50%{opacity:0;}}
  .terminal .tcursor{display:inline-block;visibility:hidden;width:.6ch;height:1.02em;background:var(--crab);transform:translateY(.16em);flex-shrink:0;}
  .terminal .inrow:focus-within .tcursor{visibility:visible;animation:termblink 1.05s steps(1) infinite;}
  .tabbar{display:flex;background:var(--side);border-bottom:1px solid var(--line);overflow-x:auto;}
  .tab{display:flex;align-items:center;gap:8px;padding:0 10px 0 12px;font-family:var(--mono);font-size:12px;color:var(--dim);border-right:1px solid var(--line);cursor:pointer;white-space:nowrap;background:var(--side);}
  .tab.on{background:var(--bg);color:var(--fg);border-top:1.5px solid var(--crab);margin-top:-1px;}
  .tab .x{width:16px;height:16px;display:flex;align-items:center;justify-content:center;border-radius:4px;color:var(--dim);}
  .tab .x:hover{background:var(--hover);color:var(--fg);}
  .edhead{display:flex;align-items:center;gap:10px;padding:0 16px;background:var(--bg);border-bottom:1px solid var(--line);font-family:var(--mono);font-size:11.5px;color:var(--dim);}
  .edhead .path .sl{opacity:.6;}
  .edhead .grow{flex:1;}
  .toggle{display:inline-flex;border:1px solid var(--line);border-radius:6px;overflow:hidden;}
  .toggle button{font-family:var(--mono);font-size:11px;padding:3px 9px;background:transparent;color:var(--dim);border:0;cursor:pointer;}
  .toggle button.on{background:var(--panel);color:var(--fg);}
  .edhead a.openrepo{color:var(--crabink);}
  .pane{overflow:auto;min-height:0;}
  .doc{max-width:760px;margin:0 auto;padding:clamp(26px,4vw,50px) clamp(20px,4vw,42px) 90px;line-height:1.62;}

  /* rendered markdown */
  .doc .crabsvg{width:48px;height:38px;color:var(--crab);display:block;margin-bottom:14px;}
  .doc h1{font-size:clamp(1.9rem,4.5vw,2.7rem);font-weight:800;letter-spacing:-.02em;margin:.1em 0 .35em;}
  .doc h2{font-family:var(--mono);font-size:.92rem;color:var(--crabink);margin:36px 0 14px;display:flex;align-items:baseline;gap:12px;}
  .doc h2::after{content:"";flex:1;height:1px;background:var(--line);}
  .doc h3{font-family:var(--mono);font-size:1rem;margin:22px 0 6px;}
  .doc p{margin:.6em 0;}
  .doc ul{list-style:none;padding:0;margin:.4em 0;}
  .doc li{padding:6px 0;border-top:1px dotted var(--line);}
  .doc li:first-child{border-top:0;}
  .doc code{font-family:var(--mono);background:var(--panel);padding:.12em .4em;border-radius:5px;font-size:.88em;}
  .doc a[href],.doc a.ilink{color:var(--crabink);border-bottom:1px solid transparent;}
  .doc a[href]:hover,.doc a.ilink:hover{border-color:var(--crabink);}
  .doc strong{font-weight:700;}
  .doc hr{border:0;border-top:1px solid var(--line);margin:1.3em 0;}
  .doc blockquote{margin:.6em 0;padding:2px 0 2px 14px;border-left:2px solid var(--line);color:var(--dim);}
  .doc .badge{font-family:var(--mono);font-size:.7em;border:1px solid var(--crab);color:var(--crab);border-radius:20px;padding:1px 8px;margin-left:6px;vertical-align:middle;}
  .doc .empty{border:1px dashed var(--line);border-radius:12px;padding:34px 22px;text-align:center;color:var(--dim);}
  .doc .empty b{color:var(--fg);}

  /* source view */
  .src{font-family:var(--mono);font-size:12.5px;line-height:1.7;padding:14px 0;counter-reset:l;color:var(--fg);overflow:auto;}
  .src .cl{display:grid;grid-template-columns:44px 1fr;}
  .src .cl::before{counter-increment:l;content:counter(l);color:var(--dim);opacity:.6;text-align:right;padding-right:14px;user-select:none;}
  .src .cl code{white-space:pre-wrap;word-break:break-word;padding-right:16px;}
  .src .mh{color:var(--crabink);font-weight:700;}
  .src .mc{color:#3a8a6d;} .src .mb{color:var(--fg);font-weight:700;} .src .ml{color:#c08a2a;}
  @media (prefers-color-scheme:dark){.src .mc{color:#6fca9f;} .src .ml{color:#e0b055;}}

  /* status bar */
  .statusbar{display:flex;align-items:center;background:var(--side);border-top:1px solid var(--line);font-family:var(--mono);font-size:11.5px;color:var(--dim);}
  .statusbar .s{padding:0 9px;height:24px;display:flex;align-items:center;gap:5px;}
  .statusbar .s.brand{background:var(--crab);color:var(--bg);}
  .statusbar .grow{flex:1;}
  .statusbar .s.hi{color:var(--fg);}

  /* palette + toast */
  .overlay{position:fixed;inset:0;background:#0006;display:none;align-items:flex-start;justify-content:center;padding-top:12vh;z-index:50;}
  .overlay.show{display:flex;}
  .palette{width:min(560px,92vw);background:var(--bg);border:1px solid var(--line);border-radius:12px;box-shadow:0 20px 60px #00000040;overflow:hidden;}
  .palette input{width:100%;border:0;background:transparent;color:var(--fg);font-family:var(--mono);font-size:15px;padding:16px 18px;outline:none;border-bottom:1px solid var(--line);}
  .palette .list{max-height:320px;overflow:auto;padding:6px;}
  .palette .opt{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;cursor:pointer;font-family:var(--mono);font-size:13px;}
  .palette .opt.hl{background:var(--sel);}
  .palette .opt .ic{color:var(--crabink);width:16px;text-align:center;}
  .palette .opt .sub{color:var(--dim);margin-left:auto;font-size:11px;}
  .toast{position:fixed;bottom:40px;left:50%;transform:translateX(-50%);background:var(--fg);color:var(--bg);font-family:var(--mono);font-size:12px;padding:8px 14px;border-radius:8px;opacity:0;transition:opacity .2s;z-index:60;pointer-events:none;}
  .toast.show{opacity:1;}

  @media (max-width:720px){
    .edcol,.edcol.term-open{grid-template-rows:34px 30px 1fr;}
    #terminal{display:none;}
    .mid{grid-template-columns:1fr;}
    .explorer{position:fixed;top:38px;bottom:24px;left:0;width:270px;z-index:40;transform:translateX(-102%);transition:transform .2s;box-shadow:0 0 40px #0003;}
    .explorer.open{transform:none;}
    .topbar .burger{display:flex;}
    .statusbar .s.brand{display:none;}
  }
</style>
</head>
<body>
<div class="app">
  <header class="topbar">
    <span class="burger" id="burger"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg></span>
    <span class="brandname">zinu.kim</span>
    <span class="grow"></span>
    <span class="kbd" id="openpal">⌘K <span style="opacity:.6">jump…</span></span>
    <span class="lang"><button class="on" data-lang="en">EN</button><button data-lang="ko">KO</button></span>
    <span class="icobtn" id="theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span>
  </header>

  <div class="mid">
    <aside class="explorer" id="explorer">
      <div class="eh"><span>Explorer</span><span>zinu.kim</span></div>
      <div class="tree" id="tree">
        <div class="trow" data-file="readme"><span class="tw"></span><span class="ic md">M↓</span>README.md</div>

        <div class="trow" data-toggle="news"><span class="tw">⌄</span><span class="ic">📁</span>news</div>
        <div class="kids" data-kids="news">
          <div class="trow" data-file="news1" style="padding-left:32px"><span class="ic md">M↓</span>2026-09-01-site.md</div>
          <div class="trow" data-file="news2" style="padding-left:32px"><span class="ic md">M↓</span>2026-08-20-zipge.md</div>
          <div class="trow" data-file="news3" style="padding-left:32px"><span class="ic md">M↓</span>2026-08-10-sideways.md</div>
        </div>

        <div class="trow" data-toggle="projects"><span class="tw">⌄</span><span class="ic">📁</span>projects</div>
        <div class="kids" data-kids="projects">
          <div class="trow" data-toggle="zipge" style="padding-left:22px"><span class="tw">⌄</span><span class="ic">📁</span>zipge</div>
          <div class="kids" data-kids="zipge">
            <div class="trow" data-file="zipge" style="padding-left:50px"><span class="ic md">M↓</span>README.md</div>
            <div class="trow" data-ext="https://github.com/soysaucecrab/zipge" style="padding-left:50px"><span class="ic ext">↗</span>repo<span class="ext-mark">↗</span></div>
          </div>
          <div class="trow" data-toggle="sideways" style="padding-left:22px"><span class="tw">⌄</span><span class="ic">📁</span>sideways</div>
          <div class="kids" data-kids="sideways">
            <div class="trow" data-file="sideways" style="padding-left:50px"><span class="ic md">M↓</span>README.md</div>
            <div class="trow" data-ext="https://github.com/soysaucecrab/sideways" style="padding-left:50px"><span class="ic ext">↗</span>repo<span class="ext-mark">↗</span></div>
          </div>
        </div>

        <div class="trow dim" data-toggle="pubs"><span class="tw">›</span><span class="ic">📁</span>publications</div>
        <div class="kids hide" data-kids="pubs">
          <div class="trow dim" data-file="pubs" style="padding-left:32px"><span class="ic">∅</span>(empty)</div>
        </div>

        <div class="trow" data-toggle="res"><span class="tw">⌄</span><span class="ic">📁</span>resources</div>
        <div class="kids" data-kids="res">
          <div class="trow" data-file="cv" style="padding-left:32px"><span class="ic md">M↓</span>cv.md</div>
          <div class="trow" data-file="links" style="padding-left:32px"><span class="ic md">M↓</span>links.md</div>
        </div>

        <div class="trow" data-file="contact"><span class="tw"></span><span class="ic md">M↓</span>contact.md</div>
      </div>
    </aside>

    <div class="edcol term-open">
      <div class="tabbar" id="tabbar"></div>
      <div class="edhead">
        <span class="path" id="edpath"></span>
        <span class="grow"></span>
        <a class="openrepo" id="openrepo" style="display:none" target="_blank" rel="noopener noreferrer">open on GitHub ↗</a>
        <span class="toggle" id="toggle"><button data-v="preview" class="on">Preview</button><button data-v="source">Source</button></span>
      </div>
      <div class="pane" id="pane"><div class="doc" id="doc"></div></div>
      <div class="terminal" id="terminal">
        <div class="th" id="termhead"><span class="on">Terminal</span><span>Output</span><span>Problems</span><span class="grow"></span><span class="chev">⌃</span></div>
        <div class="body" id="termbody"><div class="ln c">zinu.kim shell — <span class="p">help</span> for commands, <span class="p">Tab</span> to complete. (clickable nav still works)</div><div class="inrow"><span id="termprompt" class="pfx"></span><input id="terminput" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="terminal input"><span class="tcursor" aria-hidden="true"></span></div></div>
      </div>
    </div>
  </div>

  <footer class="statusbar">
    <span class="s brand">🦀 zinu.kim</span>
    <span class="s">⑂ main</span>
    <span class="s hi">ML Engineer &amp; Developer</span>
    <span class="grow"></span>
    <span class="s" id="stmode">Preview</span>
    <span class="s">UTF-8</span><span class="s">LF</span><span class="s" id="sttype">Markdown</span>
  </footer>
</div>

<div class="overlay" id="overlay">
  <div class="palette">
    <input id="palinput" placeholder="Go to file or action… (↵)" autocomplete="off">
    <div class="list" id="pallist"></div>
  </div>
</div>
<div class="toast" id="toast"></div>
<script is:inline>
const CRAB='<svg class="crabsvg" viewBox="0 0 80 64"><g fill="currentColor"><g fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"><path d="M28 42 12 45M30 48 17 55M33 52 26 62"/><path d="M52 42 68 45M50 48 63 55M47 52 54 62"/><path d="M34 30 32 19M46 30 48 19"/></g><ellipse cx="40" cy="42" rx="19" ry="12.5"/><circle cx="32" cy="16" r="3.4"/><circle cx="48" cy="16" r="3.4"/><circle cx="15" cy="35" r="7.5"/><circle cx="65" cy="35" r="7.5"/></g></svg>';

const FILES = {
  readme:{name:'README.md', path:'README.md', repo:null, src:{
    en:CRAB+`\n# Zinu Kim\n\n\`role:\` **ML Engineer & Developer** — Intelligent Software, Sungkyunkwan University\n\nI build machine learning models and turn them into products people can actually use.\n\n- [\`./email\`](mailto:me@zinu.kim) me@zinu.kim\n- [\`./github\`](https://github.com/soysaucecrab) soysaucecrab\n\n## News\n- **2026.09** — Launched my personal site, \`zinu.kim\`.\n- **2026.08** — Released the first version of \`zipge\`, an on-device search engine.\n- **2026.08** — Published \`sideways\`, a USB tethering proxy.\n\n## Projects\n- [**zipge**](file:zipge) — AI search for static sites, zero server cost.\n- [**sideways**](file:sideways) — USB SOCKS5 proxy for iPhone tethering.`,
    ko:CRAB+`\n# Zinu Kim\n\n\`role:\` **ML Engineer & Developer** — 성균관대학교 지능형소프트웨어학과\n\n머신러닝 모델을 만들고, 쓸 수 있는 제품으로 옮깁니다.\n\n- [\`./email\`](mailto:me@zinu.kim) me@zinu.kim\n- [\`./github\`](https://github.com/soysaucecrab) soysaucecrab\n\n## 소식\n- **2026.09** — 개인 웹사이트 \`zinu.kim\`을 열었습니다.\n- **2026.08** — 온디바이스 검색 엔진 \`zipge\` 첫 버전을 공개했습니다.\n- **2026.08** — USB 테더링 프록시 \`sideways\`를 공개했습니다.\n\n## 프로젝트\n- [**zipge**](file:zipge) — 정적 사이트용 AI 검색, 서버 비용 0.\n- [**sideways**](file:sideways) — iPhone 테더링용 USB SOCKS5 프록시.`}},
  news1:{name:'2026-09-01-site.md', path:'news / 2026-09-01-site.md', src:{
    en:`# 2026.09.01\n\nLaunched my personal site, \`zinu.kim\`.`, ko:`# 2026.09.01\n\n개인 웹사이트 \`zinu.kim\`을 열었습니다.`}},
  news2:{name:'2026-08-20-zipge.md', path:'news / 2026-08-20-zipge.md', src:{
    en:`# 2026.08.20\n\nReleased the first version of \`zipge\`, an on-device search engine.\n\nSee [\`projects/zipge\`](file:zipge).`, ko:`# 2026.08.20\n\n온디바이스 검색 엔진 \`zipge\` 첫 버전을 공개했습니다.\n\n[\`projects/zipge\`](file:zipge) 참고.`}},
  news3:{name:'2026-08-10-sideways.md', path:'news / 2026-08-10-sideways.md', src:{
    en:`# 2026.08.10\n\nPublished \`sideways\`, a USB tethering proxy.`, ko:`# 2026.08.10\n\nUSB 테더링 프록시 \`sideways\`를 공개했습니다.`}},
  zipge:{name:'README.md', path:'projects / zipge / README.md', repo:'https://github.com/soysaucecrab/zipge', src:{
