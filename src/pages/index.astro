// ---------- minimal markdown ----------
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function inline(s){
  return s
    .replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>')
    .replace(/\*([^*]+)\*/g,'<em>$1</em>')
    .replace(/`([^`]+)`/g,'<code>$1</code>')
    .replace(/\[([^\]]+)\]\(file:([^)]+)\)/g,'<a class="ilink" data-open="$2" href="#">$1</a>')
    .replace(/\[([^\]]+)\]\((https?:[^)]+|mailto:[^)]+)\)/g,'<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
}
function mdToHtml(src){
  const lines=src.split('\n'); let out=[], inList=false;
  const closeList=()=>{ if(inList){out.push('</ul>');inList=false;} };
  for(let raw of lines){
    const t=raw.trim();
    if(t.startsWith('<')){ closeList(); out.push(raw); continue; }
    if(t===''){ closeList(); continue; }
    if(t.startsWith('### ')){ closeList(); out.push('<h3>'+inline(esc(t.slice(4)))+'</h3>'); }
    else if(t.startsWith('## ')){ closeList(); out.push('<h2>'+inline(esc(t.slice(3)))+'</h2>'); }
    else if(t.startsWith('# ')){ closeList(); out.push('<h1>'+inline(esc(t.slice(2)))+'</h1>'); }
    else if(t==='---'){ closeList(); out.push('<hr>'); }
    else if(t.startsWith('> ')){ closeList(); out.push('<blockquote>'+inline(esc(t.slice(2)))+'</blockquote>'); }
    else if(t.startsWith('- ')){ if(!inList){out.push('<ul>');inList=true;} out.push('<li>'+inline(esc(t.slice(2)))+'</li>'); }
    else { closeList(); out.push('<p>'+inline(esc(t))+'</p>'); }
  }
  closeList(); return out.join('\n');
}
function srcHtml(src){
  return src.split('\n').map(line=>{
    let h=esc(line)
      .replace(/^(#{1,3} .*)$/,'<span class="mh">$1</span>')
      .replace(/(`[^`]+`)/g,'<span class="mc">$1</span>')
      .replace(/(\*\*[^*]+\*\*)/g,'<span class="mb">$1</span>')
      .replace(/(\[[^\]]+\]\([^)]+\))/g,'<span class="ml">$1</span>');
    return '<div class="cl"><code>'+(h||' ')+'</code></div>';
  }).join('');
}

// ---------- app state ----------
let lang='en', tabs=[], active=null, view='preview';
const doc=document.getElementById('doc'), pane=document.getElementById('pane'),
      tabbar=document.getElementById('tabbar'), edpath=document.getElementById('edpath'),
      openrepo=document.getElementById('openrepo'), toggleEl=document.getElementById('toggle'),
      stmode=document.getElementById('stmode'), sttype=document.getElementById('sttype');

function renderTabs(){
  tabbar.innerHTML=tabs.map(id=>`<div class="tab ${id===active?'on':''}" data-tab="${id}"><span>${FILES[id].name}</span><span class="x" data-close="${id}">×</span></div>`).join('');
}
function renderDoc(){
  const f=FILES[active]; const s=f.src[lang]||f.src.en;
  const v = active==='pubs' ? 'preview' : view;
  if(v==='source'){ pane.innerHTML='<div class="src">'+srcHtml(s)+'</div>'; }
  else { pane.innerHTML='<div class="doc" id="doc">'+mdToHtml(s)+'</div>'; }
  edpath.innerHTML=f.path.split(' / ').map(p=>'<span>'+p+'</span>').join(' <span class="sl">/</span> ');
  openrepo.style.display=f.repo?'inline':'none'; if(f.repo) openrepo.href=f.repo;
  toggleEl.style.visibility = active==='pubs' ? 'hidden':'visible';
  document.querySelectorAll('.toggle button').forEach(b=>b.classList.toggle('on',b.getAttribute('data-v')===v));
  stmode.textContent = v==='source'?'Source':'Preview';
  sttype.textContent = 'Markdown';
  pane.scrollTop=0;
}
function open(id){
  if(!FILES[id]) return;
  if(!tabs.includes(id)) tabs.push(id);
  active=id;
  document.querySelectorAll('.trow[data-file]').forEach(r=>r.classList.toggle('sel',r.getAttribute('data-file')===id));
  document.getElementById('explorer').classList.remove('open');
  renderTabs(); renderDoc();
}
function closeTab(id){
  const i=tabs.indexOf(id); if(i<0) return; tabs.splice(i,1);
  if(active===id){ active=tabs[Math.max(0,i-1)]||null; }
  if(!active){ tabs=['readme']; active='readme'; }
  document.querySelectorAll('.trow[data-file]').forEach(r=>r.classList.toggle('sel',r.getAttribute('data-file')===active));
  renderTabs(); renderDoc();
}

// tree events
document.querySelectorAll('.trow[data-file]').forEach(r=>r.onclick=()=>open(r.getAttribute('data-file')));
document.querySelectorAll('.trow[data-ext]').forEach(r=>r.onclick=()=>window.open(r.getAttribute('data-ext'),'_blank','noopener'));
document.querySelectorAll('.trow[data-toggle]').forEach(r=>r.onclick=()=>{const k=r.getAttribute('data-toggle');const el=document.querySelector('[data-kids="'+k+'"]');el.classList.toggle('hide');const tw=r.querySelector('.tw');if(tw)tw.textContent=el.classList.contains('hide')?'›':'⌄';});
// tab events (delegated)
tabbar.onclick=(e)=>{const c=e.target.closest('[data-close]'); if(c){closeTab(c.getAttribute('data-close'));e.stopPropagation();return;} const t=e.target.closest('[data-tab]'); if(t)open(t.getAttribute('data-tab'));};
// internal links in doc
pane.onclick=(e)=>{const a=e.target.closest('.ilink'); if(a){e.preventDefault();open(a.getAttribute('data-open'));}};
// preview/source toggle
toggleEl.onclick=(e)=>{const b=e.target.closest('button'); if(!b)return; view=b.getAttribute('data-v'); renderDoc();};
// lang + theme + burger
document.querySelectorAll('.lang button').forEach(b=>b.onclick=()=>{lang=b.getAttribute('data-lang');document.querySelectorAll('.lang button').forEach(x=>x.classList.toggle('on',x===b));document.documentElement.lang=lang;renderDoc();});
document.getElementById('theme').onclick=()=>{const r=document.documentElement;const c=r.getAttribute('data-theme')||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');r.setAttribute('data-theme',c==='dark'?'light':'dark');};
document.getElementById('burger').onclick=()=>document.getElementById('explorer').classList.toggle('open');

// toast
let tt; function toast(m){const el=document.getElementById('toast');el.textContent=m;el.classList.add('show');clearTimeout(tt);tt=setTimeout(()=>el.classList.remove('show'),1600);}

// ---------- helpers shared by terminal + palette ----------
function setThemeTo(t){const r=document.documentElement;if(t!=='light'&&t!=='dark'){const c=r.getAttribute('data-theme')||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');t=c==='dark'?'light':'dark';}r.setAttribute('data-theme',t);return t;}
function setLangTo(l){if(l!=='en'&&l!=='ko')return false;lang=l;document.querySelectorAll('.lang button').forEach(x=>x.classList.toggle('on',x.getAttribute('data-lang')===l));document.documentElement.lang=l;renderDoc();return true;}

// ---------- terminal (mini shell) ----------
const edcol=document.querySelector('.edcol'), termbody=document.getElementById('termbody'),
      terminput=document.getElementById('terminput'), termhead=document.getElementById('termhead'),
      termpromptEl=document.getElementById('termprompt');
let cwd='~', thist=[], thidx=0;
const VFS={'~':['README.md','news/','projects/','publications/','resources/','contact.md'],
  '~/news':['2026-09-01-site.md','2026-08-20-zipge.md','2026-08-10-sideways.md'],
  '~/projects':['zipge/','sideways/'],'~/projects/zipge':['README.md','repo↗'],'~/projects/sideways':['README.md','repo↗'],
  '~/publications':[],'~/resources':['cv.md','links.md']};
const PATHMAP={'~/README.md':'readme','~/contact.md':'contact',
  '~/news/2026-09-01-site.md':'news1','~/news/2026-08-20-zipge.md':'news2','~/news/2026-08-10-sideways.md':'news3',
  '~/projects/zipge/README.md':'zipge','~/projects/sideways/README.md':'sideways',
  '~/resources/cv.md':'cv','~/resources/links.md':'links'};
const HELP=['commands:','  ls [dir]        list a directory','  cd <dir>        change directory ( .. , ~ )','  pwd             print working directory','  cat <file>      print a file','  open <file>     open it in the editor','  tree            show the file tree','  whoami          identity','  theme [x]       toggle / set light|dark','  lang <x>        set en|ko','  clear           clear the screen','  email | github  open a link'].join('\n');
const TREE=['zinu.kim','├─ README.md','├─ news/','│  ├─ 2026-09-01-site.md','│  ├─ 2026-08-20-zipge.md','│  └─ 2026-08-10-sideways.md','├─ projects/','│  ├─ zipge/','│  └─ sideways/','├─ publications/   (empty)','├─ resources/','│  ├─ cv.md','│  └─ links.md','└─ contact.md'].join('\n');
function tprompt(){return `<span class="u">soysaucecrab</span><span class="c">@</span><span class="p">zinu.kim</span> <span class="c">${cwd}</span> %&nbsp;`;}
function updateTermPrompt(){termpromptEl.innerHTML=tprompt();}
function tprint(html,cls){const d=document.createElement('div');d.className='ln'+(cls?' '+cls:'');d.innerHTML=html;termbody.insertBefore(d,termbody.querySelector('.inrow'));termbody.scrollTop=termbody.scrollHeight;}
function resolve(p){let base;if(!p)return cwd;if(p[0]==='~')base=p;else if(p[0]==='/')base='~'+p;else base=cwd+'/'+p;const parts=[];base.split('/').forEach(seg=>{seg=seg.replace(/[\/↗]+$/,'');if(seg===''||seg==='.')return;if(seg==='~'){parts.length=0;parts.push('~');return;}if(seg==='..'){if(parts.length>1)parts.pop();return;}parts.push(seg);});if(parts[0]!=='~')parts.unshift('~');return parts.join('/');}
function trun(raw){
  tprint(tprompt()+esc(raw));
  const line=raw.trim(); if(line){thist.push(line);thidx=thist.length;} if(!line)return;
  const parts=line.split(/\s+/), cmd=parts[0], a1=parts[1];
  if(cmd==='help') tprint(esc(HELP));
  else if(cmd==='clear') termbody.querySelectorAll('.ln').forEach(n=>n.remove());
  else if(cmd==='pwd') tprint(esc(cwd));
  else if(cmd==='whoami') tprint('Zinu Kim — ML Engineer &amp; Developer <span class="p">🦀</span>');
  else if(cmd==='tree') tprint(esc(TREE));
  else if(cmd==='ls'){const p=resolve(a1);if(VFS[p])tprint(VFS[p].length?VFS[p].map(esc).join('    '):'<span class="c">(empty)</span>');else if(PATHMAP[p])tprint(esc(p.split('/').pop()));else tprint('ls: no such directory: '+esc(a1||cwd),'err');}
  else if(cmd==='cd'){const p=resolve(a1||'~');if(VFS[p]){cwd=p;updateTermPrompt();}else tprint('cd: no such directory: '+esc(a1||''),'err');}
  else if(cmd==='cat'){const p=resolve(a1);if(PATHMAP[p]){const f=FILES[PATHMAP[p]];tprint(esc(f.src[lang]||f.src.en));}else if(VFS[p])tprint('cat: '+esc(a1)+': is a directory','err');else tprint('cat: no such file: '+esc(a1||''),'err');}
  else if(cmd==='open'){let p=resolve(a1),id=PATHMAP[p];if(!id&&VFS[p]&&VFS[p].includes('README.md'))id=PATHMAP[p+'/README.md'];if(!id&&p==='~/publications')id='pubs';if(id){open(id);tprint('opening <span class="p">'+esc(FILES[id].name)+'</span> …');}else tprint('open: cannot open '+esc(a1||''),'err');}
  else if(cmd==='theme') tprint('theme → '+setThemeTo(a1));
  else if(cmd==='lang'){if(setLangTo(a1))tprint('lang → '+a1);else tprint('usage: lang en|ko','err');}
  else if(cmd==='email'){window.open('mailto:me@zinu.kim');tprint('opening mail …');}
  else if(cmd==='github'){window.open('https://github.com/soysaucecrab','_blank','noopener');tprint('opening github …');}
  else if(cmd==='echo') tprint(esc(parts.slice(1).join(' ')));
  else tprint('command not found: '+esc(cmd)+' — try <span class="p">help</span>','err');
}
const COMMANDS=['help','ls','cd','pwd','cat','open','tree','whoami','theme','lang','clear','email','github','echo'];
function commonPrefix(a){if(!a.length)return'';let p=a[0];for(const s of a){let i=0;while(i<p.length&&i<s.length&&p[i]===s[i])i++;p=p.slice(0,i);}return p;}
function sizeInput(){terminput.style.width=terminput.value.length+'ch';}
function completeTerm(){
  const val=terminput.value; const partial=(val.match(/(\S*)$/)||['',''])[1];
  const prefix=val.slice(0,val.length-partial.length); const isCmd=prefix.trim()==='';
  let cands;
  if(isCmd){cands=COMMANDS.filter(c=>c.startsWith(partial));}
  else{const slash=partial.lastIndexOf('/');const dirPart=slash>=0?partial.slice(0,slash+1):'';const base=slash>=0?partial.slice(slash+1):partial;const dir=resolve(dirPart||'.');const entries=VFS[dir]||[];cands=entries.filter(e=>e.replace(/[\/↗]+$/,'').toLowerCase().startsWith(base.toLowerCase())).map(e=>dirPart+e);}
  if(!cands.length)return;
  if(cands.length===1){let c=cands[0];let tr=' ';if(c.endsWith('/'))tr='';else if(c.endsWith('↗'))c=c.slice(0,-1);terminput.value=prefix+c+tr;}
  else{tprint(tprompt()+esc(val));tprint(cands.map(esc).join('    '));const cp=commonPrefix(cands.map(c=>c.replace(/↗$/,'')));if(cp.length>partial.length)terminput.value=prefix+cp;}
  sizeInput();
}
terminput.addEventListener('input',sizeInput);
terminput.addEventListener('keydown',(e)=>{
  if(e.key==='Enter'){const v=terminput.value;terminput.value='';sizeInput();trun(v);}
  else if(e.key==='Tab'){e.preventDefault();completeTerm();}
  else if(e.key==='ArrowUp'){if(thist.length){thidx=Math.max(0,thidx-1);terminput.value=thist[thidx]||'';sizeInput();e.preventDefault();}}
  else if(e.key==='ArrowDown'){if(thist.length){thidx=Math.min(thist.length,thidx+1);terminput.value=thist[thidx]||'';sizeInput();e.preventDefault();}}
  else if((e.key==='l'||e.key==='L')&&e.ctrlKey){termbody.querySelectorAll('.ln').forEach(n=>n.remove());e.preventDefault();}
});
termbody.addEventListener('click',(e)=>{if(!e.target.closest('a'))terminput.focus();});
termhead.addEventListener('click',()=>{edcol.classList.toggle('term-open');if(edcol.classList.contains('term-open'))terminput.focus();});
updateTermPrompt();sizeInput();

// ---------- command palette + fuzzy quick-open ----------
const overlay=document.getElementById('overlay'),input=document.getElementById('palinput'),plist=document.getElementById('pallist');
function fz(q,s){q=q.toLowerCase();s=(s||'').toLowerCase();if(!q)return .001;let si=0,score=0,streak=0,first=-1;for(const ch of q){let f=-1;for(let k=si;k<s.length;k++){if(s[k]===ch){f=k;break;}}if(f<0)return -1;if(first<0)first=f;if(f===si){streak++;score+=3+streak;}else{streak=0;score+=1;}si=f+1;}return score-first*0.2;}
const FILEIDS=['readme','news1','news2','news3','zipge','sideways','cv','links','contact','pubs'];
const FILEENTRIES=FILEIDS.map(id=>({ic:'M↓',label:(FILES[id].path||FILES[id].name),sub:'file',act:()=>open(id)}));
const ACTIONS=[
  {ic:'↗',label:'Open repo: zipge',sub:'github',act:()=>window.open('https://github.com/soysaucecrab/zipge','_blank','noopener')},
  {ic:'↗',label:'Open repo: sideways',sub:'github',act:()=>window.open('https://github.com/soysaucecrab/sideways','_blank','noopener')},
  {ic:'↗',label:'GitHub profile',sub:'soysaucecrab',act:()=>window.open('https://github.com/soysaucecrab','_blank','noopener')},
  {ic:'⧉',label:'Copy email',sub:'me@zinu.kim',act:()=>{navigator.clipboard&&navigator.clipboard.writeText('me@zinu.kim').then(()=>toast('Copied me@zinu.kim')).catch(()=>toast('me@zinu.kim'));}},
  {ic:'☾',label:'Toggle theme',sub:'view',act:()=>setThemeTo()},
  {ic:'⌘',label:'Language: 한국어 (KO)',sub:'view',act:()=>setLangTo('ko')},
  {ic:'⌘',label:'Language: English (EN)',sub:'view',act:()=>setLangTo('en')},
];
let hl=0,filtered=[],palBase=[];
function renderPal(){plist.innerHTML=filtered.length?filtered.map((c,i)=>`<div class="opt ${i===hl?'hl':''}" data-i="${i}"><span class="ic">${c.ic}</span><span>${c.label}</span>${c.sub?`<span class="sub">${c.sub}</span>`:''}</div>`).join(''):'<div class="opt" style="color:var(--dim)">no matches</div>';}
function filterPal(){const q=input.value.trim();if(!q){filtered=palBase.slice(0,12);}else{filtered=palBase.map(c=>({c,s:Math.max(fz(q,c.label),fz(q,c.sub))})).filter(x=>x.s>0).sort((a,b)=>b.s-a.s).map(x=>x.c).slice(0,12);}hl=0;renderPal();}
function openPal(filesOnly){palBase=filesOnly?FILEENTRIES:FILEENTRIES.concat(ACTIONS);input.value='';input.placeholder=filesOnly?'Open file…  (fuzzy)':'Go to file or action…';overlay.classList.add('show');filterPal();input.focus();}
function closePal(){overlay.classList.remove('show');}
function runPal(c){if(!c)return;closePal();c.act();}
document.getElementById('openpal').onclick=()=>openPal(false);
input.oninput=filterPal;
input.onkeydown=(e)=>{if(e.key==='ArrowDown'){hl=Math.min(hl+1,filtered.length-1);renderPal();e.preventDefault();}else if(e.key==='ArrowUp'){hl=Math.max(hl-1,0);renderPal();e.preventDefault();}else if(e.key==='Enter'){runPal(filtered[hl]);}};
plist.onclick=(e)=>{const o=e.target.closest('.opt[data-i]');if(o)runPal(filtered[+o.getAttribute('data-i')]);};
overlay.onclick=(e)=>{if(e.target===overlay)closePal();};
document.addEventListener('keydown',(e)=>{
  const k=e.key.toLowerCase();
  if(e.key==='Escape'){
    if(overlay.classList.contains('show')){closePal();}
    else if(edcol.classList.contains('term-open')){edcol.classList.remove('term-open');if(document.activeElement&&document.activeElement.blur)document.activeElement.blur();}
    else if(active){closeTab(active);}
    return;
  }
  if((e.metaKey||e.ctrlKey)&&k==='k'){e.preventDefault();openPal(false);}
  else if((e.metaKey||e.ctrlKey)&&k==='p'){e.preventDefault();openPal(true);}
});

// boot
open('readme');
