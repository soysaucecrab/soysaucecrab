---
import '../styles/fonts.css';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>zinu.kim</title>
<meta name="description" content="Zinu Kim — ML engineer and developer. Intelligent Software, Sungkyunkwan University." />
<meta property="og:title" content="zinu.kim — Zinu Kim" />
<meta property="og:description" content="ML Engineer & Developer. Intelligent Software, Sungkyunkwan University." />
<meta property="og:type" content="website" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<script is:inline>if(window.matchMedia&&matchMedia('(min-width:721px)').matches){location.replace('/'+location.hash);}</script>
<style is:global>
  :root{
    --grouped:#EFEBE1; --card:#FBF8F1; --fg:#1A1613; --dim:#8A8172; --sep:#0000001a;
    --crab:#D33A1C; --gold:#D9A24B; --navbar:#EFEBE1ee; --pill:#00000010;
    --ui:'Ubuntu','Noto Sans KR','Apple SD Gothic Neo',system-ui,-apple-system,sans-serif;
    --mono:'Ubuntu Mono','Noto Sans KR',ui-monospace,Menlo,Consolas,monospace;
  }
  @media (prefers-color-scheme:dark){
    :root{ --grouped:#0E0B07; --card:#1A140D; --fg:#EDE7D8; --dim:#8F8676; --sep:#ffffff18; --crab:#F26A45; --gold:#D9A24B; --navbar:#0E0B07ee; --pill:#ffffff14; }
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{height:100%;}
  body{margin:0;background:#b9b4ab;color:var(--fg);font-family:var(--ui);font-size:17px;
    -webkit-font-smoothing:antialiased;display:flex;align-items:center;justify-content:center;}
  @media (prefers-color-scheme:dark){body{background:#000;}}
  a{color:var(--crab);text-decoration:none;}

  .phone{width:100%;max-width:420px;height:100vh;max-height:920px;background:var(--grouped);
    position:relative;overflow:hidden;display:flex;flex-direction:column;}
  @media (min-width:460px){.phone{border-radius:44px;box-shadow:0 30px 80px #0006;border:10px solid #0a0a0a;height:min(880px,96vh);}}

  /* nav bar */
  .nav{position:relative;z-index:3;background:var(--navbar);backdrop-filter:saturate(180%) blur(14px);
    border-bottom:.5px solid var(--sep);padding-top:env(safe-area-inset-top);}
  .navrow{height:46px;display:flex;align-items:center;justify-content:center;position:relative;padding:0 12px;}
  .navrow .back{position:absolute;left:8px;display:flex;align-items:center;gap:2px;color:var(--crab);font-size:17px;cursor:pointer;}
  .navrow .back svg{width:12px;height:20px;}
  .navrow .title{font-weight:600;font-size:17px;}
  .navrow .r{position:absolute;right:10px;display:flex;align-items:center;gap:10px;}
  .toolpill{display:inline-flex;border:1px solid var(--sep);border-radius:20px;overflow:hidden;}
  .toolpill button{font-family:var(--mono);font-size:11px;padding:3px 8px;background:transparent;color:var(--dim);border:0;cursor:pointer;}
  .toolpill button.on{background:var(--crab);color:#fff;}
  .icobtn{color:var(--crab);cursor:pointer;display:flex;}
  .icobtn svg{width:20px;height:20px;}

  .large{font-size:32px;font-weight:800;letter-spacing:-.02em;padding:6px 18px 2px;}
  .large .crab{color:var(--crab);}
  .search{margin:8px 16px 12px;background:var(--pill);border-radius:10px;display:flex;align-items:center;gap:7px;padding:8px 11px;color:var(--dim);}
  .search svg{width:15px;height:15px;}
  .search input{border:0;background:transparent;outline:none;color:var(--fg);font-size:16px;flex:1;font-family:var(--ui);}

  /* scroll body with sliding screens */
  .stage{flex:1;position:relative;overflow:hidden;}
  .screen{position:absolute;inset:0;overflow:auto;background:var(--grouped);-webkit-overflow-scrolling:touch;}
  .screen.in-r{animation:inR .28s cubic-bezier(.3,.7,.2,1);}
  .screen.in-l{animation:inL .28s cubic-bezier(.3,.7,.2,1);}
  @keyframes inR{from{transform:translateX(100%);}to{transform:none;}}
  @keyframes inL{from{transform:translateX(-30%);opacity:.6;}to{transform:none;opacity:1;}}

  .sub{color:var(--dim);font-size:13px;padding:2px 18px 10px;}
  .group{margin:0 16px 22px;background:var(--card);border-radius:12px;overflow:hidden;}
  .cell{display:flex;align-items:center;gap:12px;padding:11px 14px;cursor:pointer;position:relative;}
  .cell:active{background:#00000008;}
  .cell + .cell::before{content:"";position:absolute;top:0;left:52px;right:0;height:.5px;background:var(--sep);}
  .cell .ico{width:30px;height:30px;flex-shrink:0;display:flex;align-items:center;justify-content:center;}
  .cell .ico svg{width:100%;height:100%;}
  .cell .nm{flex:1;font-size:17px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .cell .meta{color:var(--dim);font-size:15px;}
  .cell .chev{color:#00000030;}
  @media (prefers-color-scheme:dark){.cell .chev{color:#ffffff30;}}
  .cell .chev svg{width:8px;height:14px;}
  .cell.dim .nm{color:var(--dim);}

  .empty{margin:40px 24px;text-align:center;color:var(--dim);}
  .empty .big{font-size:44px;}
  .empty b{color:var(--fg);display:block;margin-top:10px;font-size:17px;}

  /* doc screen */
  .docwrap{padding:6px 20px 40px;line-height:1.62;font-size:17px;}
  .docwrap .crabsvg{width:52px;height:42px;color:var(--crab);display:block;margin:6px 0 12px;}
  .docwrap h1{font-size:1.7rem;font-weight:800;letter-spacing:-.02em;margin:.1em 0 .4em;}
  .docwrap h2{font-family:var(--mono);font-size:.9rem;color:var(--crab);margin:30px 0 12px;display:flex;align-items:baseline;gap:12px;}
  .docwrap h2::after{content:"";flex:1;height:1px;background:var(--sep);}
  .docwrap h3{font-family:var(--mono);font-size:1rem;margin:20px 0 6px;}
  .docwrap p{margin:.55em 0;}
  .docwrap ul{list-style:none;padding:0;margin:.3em 0;}
  .docwrap li{padding:9px 0;border-top:.5px solid var(--sep);}
  .docwrap li:first-child{border-top:0;}
  .docwrap code{font-family:var(--mono);background:var(--pill);padding:.12em .4em;border-radius:5px;font-size:.86em;}
  .docwrap blockquote{margin:.5em 0;padding:2px 0 2px 12px;border-left:2px solid var(--sep);color:var(--dim);}
  .docwrap hr{border:0;border-top:.5px solid var(--sep);margin:1.2em 0;}
  .docwrap .empty{margin:30px 0;}
  .repobtn{display:block;margin:8px 20px 0;text-align:center;background:var(--crab);color:#fff;font-weight:600;padding:12px;border-radius:12px;}
  .src{font-family:var(--mono);font-size:13px;line-height:1.7;padding:8px 16px 40px;counter-reset:l;white-space:pre-wrap;word-break:break-word;}
  .src .cl{display:block;}
  .src .mh{color:var(--crab);font-weight:700;} .src .mc{color:#3a8a6d;} .src .ml{color:#c08a2a;}
  @media (prefers-color-scheme:dark){.src .mc{color:#6fca9f;} .src .ml{color:#e0b055;}}

  /* tab bar */
  .tabbar{background:var(--navbar);backdrop-filter:saturate(180%) blur(14px);border-top:.5px solid var(--sep);
    display:flex;padding-bottom:env(safe-area-inset-bottom);}
  .tabbar .tb{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:7px 0 6px;color:var(--dim);cursor:pointer;font-size:10px;}
  .tabbar .tb.on{color:var(--crab);}
  .tabbar .tb svg{width:22px;height:22px;}
</style>
</head>
<body>
<div class="phone">
  <div class="nav">
    <div class="navrow">
      <span class="back" id="back" style="display:none"><svg viewBox="0 0 12 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2 2 10l8 8"/></svg><span id="backlabel"></span></span>
      <span class="title" id="navtitle"></span>
      <span class="r" id="navright">
        <span class="toolpill"><button class="on" data-lang="en">EN</button><button data-lang="ko">KO</button></span>
        <span class="icobtn" id="theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span>
      </span>
    </div>
    <div id="hdrextra"></div>
  </div>

  <div class="stage"><div class="screen" id="screen"></div></div>

  <div class="tabbar">
    <div class="tb" id="tb-recents"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2" stroke-linecap="round"/></svg>Recents</div>
    <div class="tb on" id="tb-browse"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>Browse</div>
  </div>
</div>
<script is:inline>
const CRAB='<svg class="crabsvg" viewBox="0 0 80 64"><g fill="currentColor"><g fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"><path d="M28 42 12 45M30 48 17 55M33 52 26 62"/><path d="M52 42 68 45M50 48 63 55M47 52 54 62"/><path d="M34 30 32 19M46 30 48 19"/></g><ellipse cx="40" cy="42" rx="19" ry="12.5"/><circle cx="32" cy="16" r="3.4"/><circle cx="48" cy="16" r="3.4"/><circle cx="15" cy="35" r="7.5"/><circle cx="65" cy="35" r="7.5"/></g></svg>';
const folderSVG='<svg viewBox="0 0 24 24" fill="currentColor" style="color:var(--gold)"><path d="M3 7a2 2 0 0 1 2-2h3.6a2 2 0 0 1 1.4.6L11.4 7H19a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>';
const docSVG='<svg viewBox="0 0 24 24" fill="none" stroke="var(--dim)" stroke-width="1.6"><path d="M7 3h7l4 4v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v4h4"/></svg>';
const chev='<span class="chev"><svg viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1l6 6-6 6"/></svg></span>';

const FILES={
  readme:{name:'README.md', repo:null, src:{
    en:CRAB+`\n# Zinu Kim\n\n\`role:\` **ML Engineer & Developer** — Intelligent Software, Sungkyunkwan University\n\nI build machine learning models and turn them into products people can actually use.\n\n- [email](mailto:me@zinu.kim) me@zinu.kim\n- [github](https://github.com/soysaucecrab) soysaucecrab\n\n## News\n- **2026.09** — Launched my personal site, \`zinu.kim\`.\n- **2026.08** — Released \`zipge\`, an on-device search engine.\n- **2026.08** — Published \`sideways\`, a USB tethering proxy.\n\n## Projects\n- **zipge** — AI search for static sites, zero server cost.\n- **sideways** — USB SOCKS5 proxy for iPhone tethering.`,
    ko:CRAB+`\n# Zinu Kim\n\n\`role:\` **ML Engineer & Developer** — 성균관대학교 지능형소프트웨어학과\n\n머신러닝 모델을 만들고, 쓸 수 있는 제품으로 옮깁니다.\n\n- [email](mailto:me@zinu.kim) me@zinu.kim\n- [github](https://github.com/soysaucecrab) soysaucecrab\n\n## 소식\n- **2026.09** — 개인 웹사이트 \`zinu.kim\`을 열었습니다.\n- **2026.08** — 온디바이스 검색 엔진 \`zipge\`를 공개했습니다.\n- **2026.08** — USB 테더링 프록시 \`sideways\`를 공개했습니다.\n\n## 프로젝트\n- **zipge** — 정적 사이트용 AI 검색, 서버 비용 0.\n- **sideways** — iPhone 테더링용 USB SOCKS5 프록시.`}},
  news1:{name:'2026-09-01-site.md', src:{en:`# 2026.09.01\n\nLaunched my personal site, \`zinu.kim\`.`, ko:`# 2026.09.01\n\n개인 웹사이트 \`zinu.kim\`을 열었습니다.`}},
  news2:{name:'2026-08-20-zipge.md', src:{en:`# 2026.08.20\n\nReleased the first version of \`zipge\`, an on-device search engine.`, ko:`# 2026.08.20\n\n온디바이스 검색 엔진 \`zipge\` 첫 버전을 공개했습니다.`}},
  news3:{name:'2026-08-10-sideways.md', src:{en:`# 2026.08.10\n\nPublished \`sideways\`, a USB tethering proxy.`, ko:`# 2026.08.10\n\nUSB 테더링 프록시 \`sideways\`를 공개했습니다.`}},
  zipge:{name:'README.md', repo:'https://github.com/soysaucecrab/zipge', src:{
    en:`# zipge\n\n\`status: active\`\n\nAn engine that adds AI search to static sites. Zero server or API cost — Korean semantic search runs entirely in the browser.\n\n> Tags: ML · Systems · Tooling`,
    ko:`# zipge\n\n\`status: active\`\n\n정적 사이트에 AI 검색을 붙이는 엔진. 서버·API 비용 0으로 한국어 시맨틱 검색이 브라우저 안에서 완결됩니다.\n\n> 태그: ML · 시스템 · 도구`}},
  sideways:{name:'README.md', repo:'https://github.com/soysaucecrab/sideways', src:{
    en:`# sideways\n\n\`status: shipped\`\n\nA SOCKS5 proxy that shares an iPhone's cellular data with a Mac over USB.\n\n> Tags: Systems · Tooling`,
    ko:`# sideways\n\n\`status: shipped\`\n\niPhone 셀룰러 데이터를 USB로 Mac과 공유하는 SOCKS5 프록시.\n\n> 태그: 시스템 · 도구`}},
  cv:{name:'cv.md', src:{
    en:`# Zinu Kim — CV\n\n\`role:\` **ML Engineer & Developer**\n\n## Education\n- **Sungkyunkwan University** — Intelligent Software (undergraduate)\n\n## Selected work\n- **zipge** — on-device semantic search\n- **sideways** — USB SOCKS5 tethering proxy\n\n## Contact\n- me@zinu.kim · github.com/soysaucecrab\n\n> PDF on the live site. Placeholder — final content TBD.`,
    ko:`# Zinu Kim — 이력\n\n\`role:\` **ML Engineer & Developer**\n\n## 학력\n- **성균관대학교** — 지능형소프트웨어학과 (학부)\n\n## 주요 작업\n- **zipge** — 온디바이스 시맨틱 검색\n- **sideways** — USB SOCKS5 테더링 프록시\n\n## 연락처\n- me@zinu.kim · github.com/soysaucecrab\n\n> PDF는 라이브 사이트에서. 자리표시자 — 최종 내용 미정.`}},
  links:{name:'links.md', src:{
    en:`# Links\n\n- [GitHub](https://github.com/soysaucecrab) — soysaucecrab\n- [Email](mailto:me@zinu.kim) — me@zinu.kim\n- Google Scholar — *(add when available)*`,
    ko:`# 링크\n\n- [GitHub](https://github.com/soysaucecrab) — soysaucecrab\n- [Email](mailto:me@zinu.kim) — me@zinu.kim\n- Google Scholar — *(준비되면 추가)*`}},
  contact:{name:'contact.md', src:{
    en:`# Contact\n\n- **email** — [me@zinu.kim](mailto:me@zinu.kim)\n- **github** — [soysaucecrab](https://github.com/soysaucecrab)\n\nResearch and collaboration inquiries are fastest by email.`,
    ko:`# 연락처\n\n- **email** — [me@zinu.kim](mailto:me@zinu.kim)\n- **github** — [soysaucecrab](https://github.com/soysaucecrab)\n\n연구·협업 문의는 이메일이 가장 빠릅니다.`}},
  pubsdoc:{name:'publications', src:{
    en:`<div class="empty"><div class="big">🦀</div><b>No publications yet</b><p>Papers and preprints will appear here once they're out.</p></div>`,
    ko:`<div class="empty"><div class="big">🦀</div><b>아직 등록된 논문이 없습니다</b><p>논문과 프리프린트가 공개되면 이곳에 표시됩니다.</p></div>`}},
};
const NODES={
  root:{title:'zinu.kim', large:true, items:[
    {t:'folder',name:'news',to:'news',meta:'3'},
    {t:'folder',name:'projects',to:'projects',meta:'2'},
    {t:'folder',name:'publications',to:'pubs',meta:'0'},
    {t:'folder',name:'resources',to:'res',meta:'2'},
    {t:'file',name:'README.md',file:'readme'},
    {t:'file',name:'contact.md',file:'contact'},
  ]},
  news:{title:'news', items:[{t:'file',name:'2026-09-01-site.md',file:'news1'},{t:'file',name:'2026-08-20-zipge.md',file:'news2'},{t:'file',name:'2026-08-10-sideways.md',file:'news3'}]},
  projects:{title:'projects', items:[{t:'folder',name:'zipge',to:'pz',meta:'2'},{t:'folder',name:'sideways',to:'ps',meta:'2'}]},
  pz:{title:'zipge', items:[{t:'file',name:'README.md',file:'zipge'},{t:'link',name:'repo',url:'https://github.com/soysaucecrab/zipge'}]},
  ps:{title:'sideways', items:[{t:'file',name:'README.md',file:'sideways'},{t:'link',name:'repo',url:'https://github.com/soysaucecrab/sideways'}]},
  pubs:{title:'publications', empty:'pubsdoc', items:[]},
  res:{title:'resources', items:[{t:'file',name:'cv.md',file:'cv'},{t:'file',name:'links.md',file:'links'}]},
};

// markdown (shared)
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function inline(s){return s.replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>').replace(/\*([^*]+)\*/g,'<em>$1</em>').replace(/`([^`]+)`/g,'<code>$1</code>').replace(/\[([^\]]+)\]\((https?:[^)]+|mailto:[^)]+)\)/g,'<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');}
function mdToHtml(src){const lines=src.split('\n');let out=[],inList=false;const cl=()=>{if(inList){out.push('</ul>');inList=false;}};
  for(let raw of lines){const t=raw.trim();
    if(t.startsWith('<')){cl();out.push(raw);continue;} if(t===''){cl();continue;}
    if(t.startsWith('### ')){cl();out.push('<h3>'+inline(esc(t.slice(4)))+'</h3>');}
    else if(t.startsWith('## ')){cl();out.push('<h2>'+inline(esc(t.slice(3)))+'</h2>');}
    else if(t.startsWith('# ')){cl();out.push('<h1>'+inline(esc(t.slice(2)))+'</h1>');}
    else if(t==='---'){cl();out.push('<hr>');}
    else if(t.startsWith('> ')){cl();out.push('<blockquote>'+inline(esc(t.slice(2)))+'</blockquote>');}
    else if(t.startsWith('- ')){if(!inList){out.push('<ul>');inList=true;}out.push('<li>'+inline(esc(t.slice(2)))+'</li>');}
    else{cl();out.push('<p>'+inline(esc(t))+'</p>');}}
  cl();return out.join('\n');}
function srcHtml(src){return src.split('\n').map(l=>'<span class="cl">'+(esc(l).replace(/^(#{1,3} .*)$/,'<span class="mh">$1</span>').replace(/(`[^`]+`)/g,'<span class="mc">$1</span>').replace(/(\[[^\]]+\]\([^)]+\))/g,'<span class="ml">$1</span>')||' ')+'</span>').join('\n');}

// nav
let lang='en', stack=[{type:'list',key:'root'}], docView='preview';
const screen=document.getElementById('screen'), back=document.getElementById('back'), backlabel=document.getElementById('backlabel'),
      navtitle=document.getElementById('navtitle'), hdrextra=document.getElementById('hdrextra'), navright=document.getElementById('navright');

function top(){return stack[stack.length-1];}
function iconFor(it){return it.t==='file'?docSVG:it.t==='link'?'<svg viewBox="0 0 24 24" fill="none" stroke="var(--crab)" stroke-width="1.8"><path d="M14 4h6v6M20 4l-9 9M18 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5"/></svg>':folderSVG;}

function render(dir){
  const t=top();
  // nav bar
  if(stack.length>1){ back.style.display='flex'; backlabel.textContent=stack[stack.length-2].title||''; }
  else back.style.display='none';
  const node = t.type==='list'?NODES[t.key]:null;
  const file = t.type==='doc'?FILES[t.key]:null;
  const title = t.type==='list'?node.title:file.name;
  t.title=title; navtitle.textContent = (t.type==='list'&&node.large)?'':title;
  navright.style.display = stack.length>1 ? 'none':'flex'; // show EN/KO+theme only at root-ish

  // header extra (large title + search for lists; toggle for docs)
  if(t.type==='list'){
    hdrextra.innerHTML = (node.large?`<div class="large">zinu.kim</div>`:'') +
      `<div class="search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3" stroke-linecap="round"/></svg><input id="q" placeholder="Search"></div>`;
  } else {
    hdrextra.innerHTML = `<div style="display:flex;justify-content:center;padding:0 0 8px"><span class="toolpill"><button class="${docView==='preview'?'on':''}" data-v="preview">Preview</button><button class="${docView==='source'?'on':''}" data-v="source">Source</button></span></div>`;
  }

  // screen body
  let html='';
  if(t.type==='list'){
    if(node.items.length===0 && node.empty){ html=mdToHtml(FILES[node.empty].src[lang]||FILES[node.empty].src.en); html='<div class="docwrap">'+html+'</div>'; }
    else {
      html='<div class="group" id="grp">'+node.items.map((it,i)=>`
        <div class="cell ${it.t==='file'&&it.file==='pubs'?'dim':''}" data-i="${i}">
          <span class="ico">${iconFor(it)}</span>
          <span class="nm">${it.name}</span>
          ${it.t==='folder'?`<span class="meta">${it.meta||''}</span>`+chev : it.t==='link'?`<span class="meta">↗</span>`:''}
        </div>`).join('')+'</div>';
    }
  } else {
    const s=file.src[lang]||file.src.en;
    if(docView==='source') html='<div class="src">'+srcHtml(s)+'</div>';
    else { html='<div class="docwrap">'+mdToHtml(s)+'</div>'; if(file.repo) html+=`<a class="repobtn" href="${file.repo}" target="_blank" rel="noopener noreferrer">Open on GitHub ↗</a><div style="height:24px"></div>`; }
  }
  const old=document.getElementById('screen');
  const nu=document.createElement('div'); nu.id='screen'; nu.className='screen '+(dir==='pop'?'in-l':dir==='push'?'in-r':''); nu.innerHTML=html;
  old.replaceWith(nu); wire(nu);
}
function wire(el){
  const q=el.querySelector('#q'); // search not present after replace? it's in hdrextra, not screen
  el.querySelectorAll('.cell').forEach(c=>{
    const t=top(); if(t.type!=='list')return; const it=NODES[t.key].items[+c.getAttribute('data-i')];
    c.onclick=()=>{
      if(it.t==='folder'){ stack.push({type:'list',key:it.to}); render('push'); }
      else if(it.t==='file'){ docView='preview'; stack.push({type:'doc',key:it.file}); render('push'); }
      else if(it.t==='link'){ window.open(it.url,'_blank','noopener'); }
    };
  });
}
// header search (persistent element)
document.addEventListener('input',(e)=>{ if(e.target && e.target.id==='q'){ const q=e.target.value.toLowerCase();
  document.querySelectorAll('#screen .cell').forEach(c=>{ c.style.display = c.querySelector('.nm').textContent.toLowerCase().includes(q)?'':'none'; }); }});
// preview/source toggle (persistent hdrextra)
document.addEventListener('click',(e)=>{ const b=e.target.closest('.toolpill button[data-v]'); if(b){ docView=b.getAttribute('data-v'); render('none'); }});

back.onclick=()=>{ if(stack.length>1){ stack.pop(); if(top().type==='doc')docView='preview'; render('pop'); }};
document.addEventListener('keydown',(e)=>{ if(e.key==='Escape'&&stack.length>1){ stack.pop(); if(top().type==='doc')docView='preview'; render('pop'); }});
document.querySelectorAll('.toolpill button[data-lang]').forEach(b=>b.onclick=()=>{lang=b.getAttribute('data-lang');document.querySelectorAll('.toolpill button[data-lang]').forEach(x=>x.classList.toggle('on',x===b));document.documentElement.lang=lang;render('none');});
document.getElementById('theme').onclick=()=>{const r=document.documentElement;const c=r.getAttribute('data-theme')||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');r.setAttribute('data-theme',c==='dark'?'light':'dark');};
document.getElementById('tb-browse').onclick=()=>{stack=[{type:'list',key:'root'}];render('pop');};
document.getElementById('tb-recents').onclick=()=>{stack=[{type:'list',key:'root'},{type:'doc',key:'readme'}];docView='preview';render('push');};

render('none');
</script>
</body>
</html>
