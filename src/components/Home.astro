---
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import { type Lang, t, pathFor } from '../i18n/ui';
import Crab from './Crab.astro';
import NewsList from './NewsList.astro';
import Project from './Project.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const statusOrder = { active: 0, shipped: 1, archived: 2 } as const;
const news = (await getCollection('news'))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);
const projects = (await getCollection('projects'))
  .sort((a, b) => statusOrder[a.data.status] - statusOrder[b.data.status] || +b.data.date - +a.data.date)
  .slice(0, 4);

const secondary = t(lang, 'nameSecondary');
const hasCV = existsSync('public/cv.pdf');
---
<header class="hero">
  <Crab />
  <p class="prompt m"><span class="u">soysaucecrab</span> ~ % whoami</p>
  <h1 class="name">Zinu Kim<span class="cursor" aria-hidden="true"></span>{secondary && <span class="kr">{secondary}</span>}</h1>
  <p class="role m"><span class="k">role:</span> {t(lang, 'role')}</p>
  <p class="desc">{t(lang, 'heroDesc')}</p>
  <nav class="cmds">
    <a href="mailto:me@zinu.kim">./email</a>
    <a href="https://github.com/soysaucecrab" target="_blank" rel="noopener noreferrer">./github</a>
    {hasCV && <a href="/cv.pdf">./cv.pdf</a>}
  </nav>
</header>

<div class="tree"><div class="branch">
  <section class="node">
    <p class="nlabel">
      <span class="sl">~/</span><a class="nm" href={pathFor(lang, 'news')}>news</a>
      <span class="more"><a href={pathFor(lang, 'news')}>{t(lang, 'seeAll')}</a></span>
    </p>
    <div class="nbody"><NewsList items={news} lang={lang} /></div>
  </section>

  <section class="node">
    <p class="nlabel">
      <span class="sl">~/</span><a class="nm" href={pathFor(lang, 'projects')}>projects</a>
      <span class="more"><a href={pathFor(lang, 'projects')}>{t(lang, 'seeAll')}</a></span>
    </p>
    <div class="nbody"><div class="projs">
      {projects.map((p) => <Project project={p} lang={lang} inlineStatus={true} />)}
    </div></div>
  </section>

  <section class="node">
    <p class="nlabel"><span class="sl">~/</span><span class="nm">contact</span></p>
    <div class="nbody">
      <div class="contact">
        <span><span class="k">email</span> <a href="mailto:me@zinu.kim">me@zinu.kim</a></span>
        <span><span class="k">github</span> <a href="https://github.com/soysaucecrab" target="_blank" rel="noopener noreferrer">soysaucecrab</a></span>
      </div>
    </div>
  </section>
</div></div>
