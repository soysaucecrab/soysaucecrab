---
import { getCollection } from 'astro:content';
import { type Lang, t, pathFor } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const OWNER = 'Zinu Kim';
const pubs = (await getCollection('publications')).sort((a, b) => +b.data.date - +a.data.date);
const boldOwner = (authors: string) =>
  authors.replaceAll(OWNER, `<b>${OWNER}</b>`);
const year = (d: Date) => d.getUTCFullYear();
---
<a class="back" href={pathFor(lang, 'home')}>cd ~</a>
<p class="crumb m"><span class="sl">~/</span><span class="nm">publications</span></p>

{pubs.length === 0 ? (
  <div class="nbody">
    <div class="empty">
      <p class="et">{t(lang, 'pubEmptyTitle')}</p>
      <p class="eb">{t(lang, 'pubEmptyBody')}</p>
      <p class="cmd m"><span class="u">soysaucecrab</span> ~ % ls publications/ &nbsp;&nbsp;# {t(lang, 'pubEmptyLs')}</p>
    </div>
  </div>
) : (
  <>
    <p class="psub">{t(lang, 'pubSub')}</p>
    <div class="nbody">
      <div class="refs">
        {pubs.map((pub, i) => {
          const d = pub.data;
          return (
            <div class="ref">
              <span class="n">[{i + 1}]</span>
              <div>
                <h3>{d.title[lang]}</h3>
                <p class="cite">
                  <Fragment set:html={boldOwner(d.authors)} />. <span class="ty">{d.type}</span>, {d.venue} {year(d.date)}.
                </p>
                {d.contribution && <p class="contrib">— {d.contribution[lang]}</p>}
                <p class="links">
                  {d.links?.paper && <a href={d.links.paper} target="_blank" rel="noopener noreferrer">pdf</a>}
                  {d.links?.code && <a href={d.links.code} target="_blank" rel="noopener noreferrer">code</a>}
                  {d.links?.demo && <a href={d.links.demo} target="_blank" rel="noopener noreferrer">demo</a>}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </>
)}
