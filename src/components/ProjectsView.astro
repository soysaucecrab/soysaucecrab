---
import { getCollection } from 'astro:content';
import { type Lang, t, pathFor } from '../i18n/ui';
import Project from './Project.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const all = await getCollection('projects');
const byDate = (a, b) => +b.data.date - +a.data.date;
const apps = all.filter((p) => p.data.kind === 'app').sort(byDate);
const order = ['active', 'shipped', 'archived'] as const;
const groups = order
  .map((status) => ({
    status,
    items: all
      .filter((p) => p.data.kind !== 'app' && p.data.status === status)
      .sort(byDate),
  }))
  .filter((g) => g.items.length > 0);
---
<a class="back" href={pathFor(lang, 'home')}>cd ~</a>
<p class="crumb m"><span class="sl">~/</span><span class="nm">projects</span></p>
<p class="psub">{t(lang, 'projSub')}</p>
<div class="nbody">
  {apps.length > 0 && (
    <div class="group">
      <p class="gh active"><span class="b"></span>apps</p>
      <div class="projs">
        {apps.map((p) => <Project project={p} lang={lang} inlineStatus={true} />)}
      </div>
    </div>
  )}
  {groups.map((g) => (
    <div class="group">
      <p class:list={['gh', g.status]}><span class="b"></span>{g.status}</p>
      <div class="projs">
        {g.items.map((p) => <Project project={p} lang={lang} />)}
      </div>
    </div>
  ))}
</div>
