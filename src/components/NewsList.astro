---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';

interface Props {
  items: CollectionEntry<'news'>[];
  lang: Lang;
}
const { items, lang } = Astro.props;
const ym = (d: Date) => `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
---
<div class="news">
  {items.map((n) => (
    <div class="row">
      <time datetime={n.data.date.toISOString().slice(0, 7)}>{ym(n.data.date)}</time>
      <p>{n.data.title[lang]}</p>
    </div>
  ))}
</div>
