---
import type { CollectionEntry } from 'astro:content';
import { type Lang, tags } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  inlineStatus?: boolean;
}
const { project, lang, inlineStatus = false } = Astro.props;
const d = project.data;
const links = d.links ?? {};
---
<div class:list={['proj', d.status === 'archived' && 'archived']}>
  {inlineStatus && (
    <p class:list={['st', d.status]}><span class="b"></span>{d.status}</p>
  )}
  <h3>
    {links.repo
      ? <a href={links.repo} target="_blank" rel="noopener noreferrer">{d.name}</a>
      : d.name}
  </h3>
  <p class="desc">{d.blurb[lang]}</p>
  <p class="foot">
    <span class="tags">{tags(lang, d.tags)}</span>
    <span class="links">
      {links.repo && <a href={links.repo} target="_blank" rel="noopener noreferrer">repo</a>}
      {links.demo && <a href={links.demo} target="_blank" rel="noopener noreferrer">demo</a>}
      {links.paper && <a href={links.paper} target="_blank" rel="noopener noreferrer">paper</a>}
    </span>
  </p>
</div>
